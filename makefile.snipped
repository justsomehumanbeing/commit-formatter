.PHONY: commit-fmt-bootstrap commit-fmt-install

commit-fmt-bootstrap:
	@git submodule add <URL-ZUM-COMMIT-FMT-REPO> .tools/commit-fmt || true
	@git submodule update --init --recursive
	@echo ""
	@echo "commit-fmt added as submodule in .tools/commit-fmt"
	@echo "Update later with:"
	@echo "  git submodule update --remote --merge"
	@echo "  git add .tools/commit-fmt .gitmodules"
	@echo "  git commit -m \"chore(tools): bump commit-fmt\""
	@echo ""

commit-fmt-install:
	@mkdir -p .git/hooks
	@printf '%s\n' '#!/usr/bin/env bash' \
		'exec "$$PWD/.tools/commit-fmt/commit-fmt.sh" "$$@"' \
		> .git/hooks/prepare-commit-msg
	@chmod +x .git/hooks/prepare-commit-msg
	@echo "✔ commit-fmt hook installed from submodule"
